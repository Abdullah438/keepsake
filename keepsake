#!/usr/bin/env bash
# keepsake — snapshot configs, packages, and dev-environment state, then put them back.
set -euo pipefail

VERSION="1.4.1"

SOURCE=${BASH_SOURCE[0]}
while [[ -L $SOURCE ]]; do
  _dir=$(cd "$(dirname "$SOURCE")" && pwd)
  SOURCE=$(readlink "$SOURCE")
  [[ $SOURCE != /* ]] && SOURCE="$_dir/$SOURCE"
done
SCRIPT_DIR=$(cd "$(dirname "$SOURCE")" && pwd)
unset _dir SOURCE

_cfg_root="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="$_cfg_root/keepsake"

if [[ -n ${KEEPSAKE_DIR:-} ]]; then
  DATA_DIR=$KEEPSAKE_DIR
elif [[ -n ${DISTROHOP_DIR:-} ]]; then
  DATA_DIR=$DISTROHOP_DIR
else
  DATA_DIR=$HOME/Backups/keepsake
fi
MANIFEST="$CONFIG_DIR/manifest.conf"
SETTINGS_CONF="${SETTINGS_CONF:-$CONFIG_DIR/settings.conf}"

# Only ever used as display text in usage(); $USER is not set everywhere.
USER_DISPLAY=${USER:-$(id -un 2>/dev/null || echo user)}

DEFAULT_GROUPS=(core apps gtk editor packages dev)
ALL_FILE_GROUPS=(core apps gtk editor secrets extra)
PRUNE_DEFAULT_KEEP=10

DRY_RUN=0
WANT_SECRETS=0
WANT_ARCHIVE=0
WANT_UP=0
WANT_GH=0
WANT_YES=0
WANT_NO_VERIFY=0
WANT_PUSH=0
WANT_PULL=0
WANT_LOCAL_ONLY=0
WANT_S3_ONLY=0
DEST_OVERRIDE=""
NAME_OVERRIDE=""
GROUPS_OVERRIDE=""
WITH_GROUPS=""
PICKED=""
KEEP_N=""
OLDER_THAN=""

if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GRN=$'\033[32m'
  C_YEL=$'\033[33m'
  C_BLU=$'\033[34m'
  C_CYN=$'\033[36m'
else
  C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GRN='' C_YEL='' C_BLU='' C_CYN=''
fi

ok()   { printf '%s%s%s %s\n' "$C_GRN" "✔" "$C_RESET" "$*"; }
info() { printf '%s%s%s %s\n' "$C_BLU" "→" "$C_RESET" "$*"; }
warn() { printf '%s%s%s %s\n' "$C_YEL" "!" "$C_RESET" "$*" >&2; }
err()  { printf '%s%s%s %s\n' "$C_RED" "✖" "$C_RESET" "$*" >&2; }
die()  { err "$*"; exit 1; }

# One-time rename from distrohop. Must run before lib/ is sourced so s3.conf
# and the manifest are read from the new location.
if [[ ! -e $_cfg_root/keepsake && -d $_cfg_root/distrohop ]]; then
  mv "$_cfg_root/distrohop" "$_cfg_root/keepsake" \
    || die "couldn't move $_cfg_root/distrohop → $CONFIG_DIR"
  printf '%s%s%s %s\n' "$C_BLU" "→" "$C_RESET" "moved config $_cfg_root/distrohop → $CONFIG_DIR" >&2
fi
if [[ -z ${KEEPSAKE_DIR:-} && -z ${DISTROHOP_DIR:-} \
      && ! -e $HOME/Backups/keepsake && -d $HOME/Backups/distrohop ]]; then
  mkdir -p "$HOME/Backups"
  mv "$HOME/Backups/distrohop" "$HOME/Backups/keepsake" \
    || die "couldn't move $HOME/Backups/distrohop → $DATA_DIR"
  info "moved snapshots $HOME/Backups/distrohop → $DATA_DIR" >&2
fi
unset _cfg_root

usage() {
  cat <<EOF
${C_BOLD}keepsake${C_RESET} ${C_DIM}v$VERSION${C_RESET} — snapshot configs, packages, and the rest of a working machine

${C_BOLD}USAGE${C_RESET}
  keepsake backup  [--name NAME] [--dest DIR] [--groups LIST] [--with LIST] [--secrets] [--archive] [--push]
  keepsake restore SNAPSHOT [--groups LIST] [--with LIST] [--secrets] [--up] [--yes] [--dry-run] [--pull]
  keepsake clone   [SNAPSHOT] [--gh] [--dry-run]
  keepsake prune   [--keep N] [--dry-run]
  keepsake delete  NAME [--local-only|--s3-only] [--dry-run]   (alias: rm)
  keepsake clean   [--older-than DAYS] [--dry-run]
  keepsake s3      configure ENVFILE | push [SNAPSHOT] [--secrets] [--no-verify] | pull NAME [--no-verify] | ls | prune [--keep N]
  keepsake list    (alias: ls)   — newest first, shows S3 push status if s3 is configured
  keepsake show    SNAPSHOT
  keepsake verify  SNAPSHOT
  keepsake status  [--groups LIST]
  keepsake packages dump | apply [--portable] [--dry-run]
  keepsake bootstrap [--dry-run]
  keepsake dconf   export | import [FILE]
  keepsake config  get|set KEY [VALUE]
  keepsake edit              — manifest (micro if installed, else \$EDITOR)
  keepsake install

${C_BOLD}BACKUP GROUPS${C_RESET}  (default: ${DEFAULT_GROUPS[*]})
  core         zsh, p10k, bash, git, nano
  apps         fastfetch, alacritty, btop, cava, micro, fontconfig, gh, systemd units
  gtk          gtk-3/4 settings
  editor       Cursor settings.json
  packages     pacman/dnf/apt/zypper + AUR + flatpak lists (always dumped on backup)
  dev          ~/Dev clone map (GitHub remotes + folder tree), .env files, docker volumes
  secrets      ssh private keys, gh hosts, rclone.conf  ${C_DIM}(opt-in)${C_RESET}
  extra        whatever you add under [extra] in the manifest
                 Absolute paths (/etc/...) go in system/ and restore in place.

${C_BOLD}SETTINGS${C_RESET}  (keepsake config get|set KEY VALUE)
  dev_root     where your dev tree lives (default: ~/Dev, or \$KEEPSAKE_DEV for a one-off override)

${C_BOLD}EXAMPLES${C_RESET}
  keepsake backup --name workstation
  keepsake backup --secrets
  keepsake backup --secrets --push             # backup, then upload to S3/R2
  keepsake backup --dest /run/media/$USER_DISPLAY/USB --archive --secrets
  keepsake restore workstation                 # checkbox picker
  keepsake restore workstation --yes           # defaults, no prompt
  keepsake restore workstation --pull          # download from S3/R2 first
  keepsake restore workstation --up
  keepsake clone workstation --gh
  keepsake prune --keep 5
  keepsake delete workstation                  # remove local + remote copy
  keepsake delete workstation --local-only
  keepsake delete workstation --s3-only
  keepsake clean --older-than 30
  keepsake s3 push workstation                 # upload as-is
  keepsake s3 push workstation --secrets       # ...and add ssh keys / rclone.conf
  keepsake s3 pull workstation
  keepsake verify workstation                  # checksum a local snapshot
  keepsake s3 prune --keep 5
  keepsake packages apply --portable
  keepsake bootstrap
  keepsake config set dev_root ~/Projects

Snapshots land in ${C_CYN}$DATA_DIR${C_RESET}
Edit what gets copied: ${C_CYN}keepsake edit${C_RESET}
EOF
}

# ---------------------------------------------------------------------------
# Manifest
# ---------------------------------------------------------------------------

ensure_manifest() {
  mkdir -p "$CONFIG_DIR"
  if [[ ! -f $MANIFEST ]]; then
    if [[ -f $SCRIPT_DIR/manifest.conf ]]; then
      cp "$SCRIPT_DIR/manifest.conf" "$MANIFEST"
    else
      die "no manifest at $MANIFEST and no bundled copy next to the script"
    fi
    info "wrote default manifest → $MANIFEST"
  fi
}

# parse_manifest GROUP → prints paths (one per line)
parse_manifest() {
  local want=$1 current="" line
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=${line%"${line##*[![:space:]]}"}
    line=${line#"${line%%[![:space:]]*}"}
    [[ -z $line ]] && continue
    if [[ $line =~ ^\[([^]]+)\]$ ]]; then
      current=${BASH_REMATCH[1]}
      continue
    fi
    [[ $current == "$want" ]] && printf '%s\n' "$line"
  done < "$MANIFEST"
}

active_groups() {
  local raw=${GROUPS_OVERRIDE:-${DEFAULT_GROUPS[*]}}
  raw=${raw//,/ }
  if [[ -n ${WITH_GROUPS:-} ]]; then
    raw+=" ${WITH_GROUPS//,/ }"
  fi
  # --secrets implies the secrets group
  if (( WANT_SECRETS )); then
    [[ " $raw " == *" secrets "* ]] || raw+=" secrets"
  fi
  printf '%s\n' $raw
}

group_wanted() {
  local g=$1 x
  for x in $(active_groups); do
    [[ $x == "$g" ]] && return 0
  done
  return 1
}

restore_wanted() {
  local id=$1 x
  for x in $PICKED; do
    [[ $x == "$id" ]] && return 0
  done
  return 1
}

restore_default_on() {
  local id=$1
  case $id in
    core|apps|gtk|editor|clone|envs|bind|volumes|files|dev-apps) return 0 ;;
    secrets) (( WANT_SECRETS )) && return 0; group_wanted secrets && return 0; return 1 ;;
    *) return 1 ;;
  esac
}

restore_collect_items() {
  local snap=$1
  UI_IDS=()
  UI_LABELS=()
  UI_ON=()

  add_restore_item() {
    local id=$1 label=$2 on=0
    restore_default_on "$id" && on=1
    if [[ -n ${WITH_GROUPS:-} && " ${WITH_GROUPS//,/ } " == *" $id "* ]]; then
      on=1
    fi
    UI_IDS+=("$id")
    UI_LABELS+=("$label")
    UI_ON+=("$on")
  }

  snapshot_has_group() {
    local g=$1
    [[ -f $snap/MANIFEST.txt ]] && grep -q $'^'"$g"$'\t' "$snap/MANIFEST.txt"
  }

  if [[ -f $snap/MANIFEST.txt ]]; then
    snapshot_has_group core && add_restore_item core "zsh, p10k, bash, git, nano"
    snapshot_has_group apps && add_restore_item apps "alacritty, btop, gh, fonts, systemd"
    snapshot_has_group gtk && add_restore_item gtk "gtk-3/4 settings"
    snapshot_has_group editor && add_restore_item editor "Cursor settings.json"
    snapshot_has_group extra && add_restore_item extra "extra paths from the manifest"
  elif [[ -d $snap/files ]]; then
    add_restore_item files "all config files in the snapshot"
  fi

  if [[ -d $snap/secrets ]] && { snapshot_has_group secrets || [[ -n $(find "$snap/secrets" -mindepth 1 -print -quit 2>/dev/null) ]]; }; then
    add_restore_item secrets "ssh keys, gh hosts, rclone.conf"
  fi

  [[ -x $snap/dev/clone-dev.sh ]] && add_restore_item clone "rebuild ~/Dev from GitHub remotes"
  if [[ -d $snap/dev/envs ]] && [[ -n $(find "$snap/dev/envs" -type f -print -quit 2>/dev/null) ]]; then
    add_restore_item envs "restore .env / .npmrc files"
  fi
  [[ -s $snap/dev/bind/PATHS.txt ]] && add_restore_item bind "restore compose data dirs"
  [[ -s $snap/dev/volumes/NAMES.txt ]] && add_restore_item volumes "restore docker named volumes"
  [[ -s $snap/packages/portable.txt ]] && add_restore_item packages "install portable packages (pacman/dnf/apt/zypper + AUR + flatpak)"
  [[ -f $snap/packages/dev-apps.json ]] && add_restore_item dev-apps "development apps (auto-install + manual notes)"
}

restore_pick_or_default() {
  local snap=$1
  if [[ -z $GROUPS_OVERRIDE ]] && (( ! WANT_YES )) && [[ -t 0 && -t 1 && -c /dev/tty ]]; then
    restore_collect_items "$snap"
    if ((${#UI_IDS[@]})); then
      ui_checklist || die "restore cancelled"
      PICKED=$UI_PICKED
      return 0
    fi
  fi
  local x sel=()
  for x in $(active_groups); do
    case $x in
      packages)
        if [[ -n $GROUPS_OVERRIDE || " ${WITH_GROUPS//,/ } " == *" packages "* ]]; then
          sel+=(packages)
        fi
        ;;
      dev) sel+=(clone envs bind volumes) ;;
      *) sel+=("$x") ;;
    esac
  done
  PICKED="${sel[*]}"
}

# shellcheck source=lib/conf.sh
if [[ -f $SCRIPT_DIR/lib/conf.sh ]]; then
  source "$SCRIPT_DIR/lib/conf.sh"
fi

dev_root=""
conf_load_kv "$SETTINGS_CONF" dev_root 2>/dev/null || true

