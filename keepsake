# ---------------------------------------------------------------------------
# Copy helpers
# ---------------------------------------------------------------------------

RSYNC_EXCLUDES=(
  --exclude='*.bak'
  --exclude='*.old'
  --exclude='__pycache__'
  --exclude='buffers/'
  --exclude='backups/'
  --exclude='*.wants/'
  --exclude='known_hosts.old'
)

item_exists() {
  local p=$1
  [[ -e $p || -L $p ]]
}

is_abs_path() { [[ $1 == /* ]]; }

# Copy a live file/dir into the snapshot. Absolute manifest paths land under
# system/ (so restore cannot rsync them into $HOME). Home-relative paths stay
# under files/ or secrets/.
copy_system_item() {
  local abs=$1 snap=$2
  local src=$abs dest="$snap/system$abs"
  if ! item_exists "$src"; then
    warn "skip (missing): $abs"
    return 1
  fi
  if (( DRY_RUN )); then
    printf '  %s\n' "$abs"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  if [[ -d $src && ! -L $src ]]; then
    mkdir -p "$dest"
    rsync -a "${RSYNC_EXCLUDES[@]}" "$src/" "$dest/"
  else
    rsync -a "${RSYNC_EXCLUDES[@]}" "$src" "$dest"
  fi
}

# Best-effort write to dest, with sudo when the parent dir is not writable
# (typical for /etc). Existing dest is saved as *.pre-hop.TIMESTAMP first.
install_path() {
  local src=$1 dest=$2
  local dest_dir bak
  dest_dir=$(dirname "$dest")

  if [[ -e $dest || -L $dest ]]; then
    bak="${dest}.pre-hop.$(date +%Y%m%d%H%M%S)"
    if [[ -w $dest_dir ]]; then
      if [[ -d $dest && ! -L $dest ]]; then
        mkdir -p "$bak"
        rsync -a "$dest/" "$bak/"
      else
        cp -a "$dest" "$bak"
      fi
    elif command -v sudo >/dev/null 2>&1; then
      if [[ -d $dest && ! -L $dest ]]; then
        sudo mkdir -p "$bak"
        sudo rsync -a "$dest/" "$bak/"
      else
        sudo cp -a "$dest" "$bak"
      fi
    else
      warn "cannot backup $dest before overwrite"
      return 1
    fi
  fi

  if mkdir -p "$dest_dir" 2>/dev/null && [[ -w $dest_dir ]]; then
    if [[ -d $src && ! -L $src ]]; then
      mkdir -p "$dest"
      rsync -a "$src/" "$dest/"
    else
      rsync -a "$src" "$dest"
    fi
  elif command -v sudo >/dev/null 2>&1; then
    sudo mkdir -p "$dest_dir"
    if [[ -d $src && ! -L $src ]]; then
      sudo mkdir -p "$dest"
      sudo rsync -a "$src/" "$dest/"
    else
      sudo rsync -a "$src" "$dest"
    fi
  else
    warn "cannot write $dest — need root"
    return 1
  fi
}

restore_system_item() {
  local abs=$1 snap=$2
  local src="$snap/system$abs"
  if ! item_exists "$src"; then
    return 1
  fi
  if (( DRY_RUN )); then
    printf '  %s → %s\n' "$abs" "$abs"
    return 0
  fi
  install_path "$src" "$abs"
}

# After restoring /etc/udev/hwdb.d/* , rebuild the binary hwdb so the rule
# is live without a reboot.
apply_hwdb_if_needed() {
  local snap=$1 g rel
  [[ -f $snap/MANIFEST.txt ]] || return 0
  while IFS=$'\t' read -r g rel; do
    [[ $rel == /etc/udev/hwdb.d/* ]] || continue
    restore_wanted "$g" || continue
    if command -v systemd-hwdb >/dev/null 2>&1; then
      systemd-hwdb update 2>/dev/null \
        || sudo systemd-hwdb update \
        || warn "systemd-hwdb update failed"
    elif command -v udevadm >/dev/null 2>&1; then
      udevadm hwdb --update 2>/dev/null \
        || sudo udevadm hwdb --update \
        || warn "udevadm hwdb --update failed"
    fi
    if command -v udevadm >/dev/null 2>&1; then
      udevadm trigger --subsystem-match=input 2>/dev/null \
        || sudo udevadm trigger --subsystem-match=input 2>/dev/null \
        || true
    fi
    info "rebuilt hwdb so $rel is live"
    return 0
  done < "$snap/MANIFEST.txt"
}

# shellcheck disable=SC2088  # "~/..." here is display text, not a path
copy_item() {
  local rel=$1 dest_root=$2
  local src="$HOME/$rel" dest="$dest_root/$rel"
  if ! item_exists "$src"; then
    warn "skip (missing): ~/$rel"
    return 1
  fi
  if (( DRY_RUN )); then
    printf '  %s\n' "~/$rel"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  if [[ -d $src && ! -L $src ]]; then
    mkdir -p "$dest"
    rsync -a "${RSYNC_EXCLUDES[@]}" "$src/" "$dest/"
  else
    rsync -a "${RSYNC_EXCLUDES[@]}" "$src" "$dest"
  fi
}

restore_item() {
  local rel=$1 src_root=$2
  local src="$src_root/$rel" dest="$HOME/$rel"
  if ! item_exists "$src"; then
    return 1
  fi
  if (( DRY_RUN )); then
    printf '  %s → ~/%s\n' "$rel" "$rel"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  if [[ -e $dest || -L $dest ]]; then
    local bak
    bak="${dest}.pre-hop.$(date +%Y%m%d%H%M%S)"
    if [[ -d $dest && ! -L $dest ]]; then
      mkdir -p "$bak"
      rsync -a "$dest/" "$bak/"
    else
      cp -a "$dest" "$bak"
    fi
  fi
  if [[ -d $src && ! -L $src ]]; then
    mkdir -p "$dest"
    rsync -a "$src/" "$dest/"
  else
    rsync -a "$src" "$dest"
  fi
}

# ---------------------------------------------------------------------------
# Packages
# ---------------------------------------------------------------------------

# Bundled desktop-session classifier: KDE package names on Arch/pacman only.
# Only ever applied when the *live* session is actually detected as KDE (see
# is_kde_live below) — on every other DE/distro combination this is a no-op
# and packages fall through to the generic [packages_exclude] manifest layer.
KDE_SESSION_RE='^(bluedevil|breeze(-.*)?|cachyos-.*kde.*|cachyos-kde-settings|kde-gtk-config|kdeplasma-addons|kscreen|kwallet.*|kwin.*|oxygen(-.*)?|phonon-.*|plasma-.*|plymouth-kcm|powerdevil)$'
KDE_APPS_RE='^(ark|dolphin|ffmpegthumbs|filelight|gwenview|haruna|kate|kcalc|kdeconnect|kdegraphics-thumbnailers|kdialog|kinfocenter|kio-admin|konsole|partitionmanager|spectacle)$'

is_kde_session() { [[ $1 =~ $KDE_SESSION_RE ]]; }
is_kde_app()     { [[ $1 =~ $KDE_APPS_RE ]]; }

is_kde_live() {
  local de="${XDG_CURRENT_DESKTOP:-}${DESKTOP_SESSION:-}"
  [[ ${de,,} == *kde* || ${de,,} == *plasma* ]]
}

# Filters $1 (a package list, one name per line) in place against glob
# patterns from the manifest's [packages_exclude] section — the DE/distro
# generic escape hatch for "don't reinstall these portably".
apply_packages_excludes() {
  local list=$1
  [[ -f $MANIFEST ]] || return 0
  local -a patterns=()
  local pat
  while IFS= read -r pat; do
    [[ -n $pat ]] && patterns+=("$pat")
  done < <(parse_manifest packages_exclude)
  ((${#patterns[@]})) || return 0

  local tmp="$list.tmp" pkg keep p
  : > "$tmp"
  while IFS= read -r pkg; do
    [[ -z $pkg ]] && continue
    keep=1
    for p in "${patterns[@]}"; do
      # shellcheck disable=SC2053
      [[ $pkg == $p ]] && { keep=0; break; }
    done
    (( keep )) && printf '%s\n' "$pkg" >> "$tmp"
  done < "$list"
  mv "$tmp" "$list"
}

# Splits packages/explicit.txt into portable.txt (+ kde-session.txt /
# kde-apps.txt when the live session is actually KDE on pacman), then
# applies the generic exclude list on top.
classify_packages() {
  local out=$1 pm=$2
  if [[ $pm == pacman ]] && is_kde_live; then
    : > "$out/portable.txt"; : > "$out/kde-session.txt"; : > "$out/kde-apps.txt"
    local pkg
    while IFS= read -r pkg; do
      [[ -z $pkg ]] && continue
      if is_kde_session "$pkg"; then
        printf '%s\n' "$pkg" >> "$out/kde-session.txt"
      elif is_kde_app "$pkg"; then
        printf '%s\n' "$pkg" >> "$out/kde-apps.txt"
      else
        printf '%s\n' "$pkg" >> "$out/portable.txt"
      fi
    done < "$out/explicit.txt"
  else
    cp "$out/explicit.txt" "$out/portable.txt" 2>/dev/null || : > "$out/portable.txt"
  fi
  apply_packages_excludes "$out/portable.txt"
}

dump_packages() {
  local out=$1 pm
  mkdir -p "$out"
  pm=$(pm_detect)
  printf '%s\n' "$pm" > "$out/pm.txt"

  if [[ $pm != none ]]; then
    pm_explicit_packages "$pm" > "$out/explicit.txt" 2>/dev/null || : > "$out/explicit.txt"
  else
    : > "$out/explicit.txt"
    warn "no supported package manager (pacman/dnf/apt/zypper) — explicit.txt left empty"
  fi

  if [[ $pm == pacman ]]; then
    pacman -Qqm > "$out/aur.txt" 2>/dev/null || : > "$out/aur.txt"
  else
    : > "$out/aur.txt"
  fi

  classify_packages "$out" "$pm"

  if command -v flatpak >/dev/null 2>&1; then
    flatpak list --app --columns=application > "$out/flatpak.txt" 2>/dev/null || : > "$out/flatpak.txt"
  else
    : > "$out/flatpak.txt"
  fi
}

write_notes() {
  local snap=$1
  local host os de
  host=$(hostname 2>/dev/null || echo unknown)
  os=$(grep -E '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2- | tr -d '"')
  de=${XDG_CURRENT_DESKTOP:-unknown}

  local dev_examples=""
  if declare -F dev_repos >/dev/null; then
    dev_examples=$(dev_repos | cut -f1 | head -5 | paste -sd, -)
  fi

  cat > "$snap/NOTES.txt" <<EOF
keepsake snapshot
==================
date:     $(date -Iseconds)
host:     $host
os:       ${os:-unknown}
desktop:  $de
home:     $HOME
groups:   $(active_groups | tr '\n' ' ')

Restore
-------
1. Copy this folder (or the .tar.zst) onto the machine you're restoring to.
2. Put keepsake on PATH (or run it from this repo):
     ./keepsake install
3. Restore configs (existing files are saved as *.pre-hop.*):
     keepsake restore $snap
4. Reinstall the shell stack (zsh, p10k, plugins, fonts):
     keepsake bootstrap
5. Reinstall portable packages (DE session packages are listed separately):
     keepsake packages apply --portable

Notes
-----
- zshrc sources system paths (/usr/share/oh-my-zsh, p10k, zsh plugins) on
  Arch, where bootstrap installs them as system packages. On dnf/apt/zypper,
  bootstrap instead git-clones oh-my-zsh/p10k/plugins into
  ~/.local/share/keepsake/zsh-plugins — .zshrc may need updating to source
  from there instead.
- git commit signing uses ~/.ssh/id_ed25519_gitsign — restore with --secrets
  or copy that key by hand.
- terminal-news: after restore,
    systemctl --user daemon-reload
    systemctl --user enable --now terminal-news.timer
- Development apps (Cursor, Docker, nvm, …) are listed in packages/dev-apps.txt.
  Tick dev-apps in the restore picker to try automated install; leftover
  manual steps are printed at the end.
- Absolute manifest paths (e.g. /etc/udev/hwdb.d/…) restore in place, not
  under \$HOME. Writing /etc may prompt for sudo. After hwdb rules,
  keepsake runs systemd-hwdb update and udevadm trigger.

Restore asks what to put back (checkboxes). Skip the prompt with --yes.

~/Dev
-----
Git repos are NOT copied. The snapshot records remotes + folder layout.
To rebuild the tree:

    keepsake clone $snap
    # or:  $snap/dev/clone-dev.sh

That recreates the repos this snapshot mapped under $DEV_ROOT${dev_examples:+ (e.g. $dev_examples, …)} and
clones each GitHub remote into place. Private remotes need gh auth (--gh)
or SSH keys (--secrets).

.env files, compose bind-mounts, and named docker volumes live under
dev/envs, dev/bind, dev/volumes. They are gitignored on purpose — keep
them off a public remote. Restore brings them back automatically.
Then start stacks with:  keepsake restore $snap --up

Secrets
-------
SSH private keys, gh hosts.yml, and rclone.conf are only in this snapshot
if you passed --secrets. They live under secrets/ and restore only with
the same flag.
EOF
}

write_meta() {
  local snap=$1
  mkdir -p "$snap/meta"
  hostname > "$snap/meta/hostname" 2>/dev/null || echo unknown > "$snap/meta/hostname"
  cp /etc/os-release "$snap/meta/os-release" 2>/dev/null || true
  printf '%s\n' "${XDG_CURRENT_DESKTOP:-unknown}" > "$snap/meta/desktop"
  date -Iseconds > "$snap/meta/date"
  uname -a > "$snap/meta/uname"
  printf '%s\n' "$HOME" > "$snap/meta/home"
  printf '%s\n' "$VERSION" > "$snap/meta/keepsake-version"
  active_groups > "$snap/meta/groups"
}

# ---------------------------------------------------------------------------
# Snapshot integrity
# ---------------------------------------------------------------------------

# Hash every file in the finished snapshot so `keepsake verify` can answer
# "is this snapshot still intact?" without a network round-trip. Skipped by
# --no-verify, and never fatal — a snapshot without SHA256SUMS is still a
# usable snapshot.
write_checksums() {
  local snap=$1
  (( WANT_NO_VERIFY )) && return 0
  if ! command -v sha256sum >/dev/null 2>&1; then
    warn "sha256sum not found — snapshot written without SHA256SUMS"
    return 0
  fi
  info "checksumming snapshot"
  if ( cd "$snap" \
        && find . -type f ! -name SHA256SUMS ! -name 'SHA256SUMS.tmp' -print0 \
           | sort -z \
           | xargs -0 -r sha256sum > SHA256SUMS.tmp ) 2>/dev/null; then
    mv "$snap/SHA256SUMS.tmp" "$snap/SHA256SUMS"
  else
    rm -f "$snap/SHA256SUMS.tmp"
    warn "could not checksum every file — snapshot written without SHA256SUMS"
  fi
}

cmd_verify() {
  local snap
  snap=$(resolve_snapshot "${1:-}")
  local name; name=$(basename "$snap")
  [[ -f $snap/SHA256SUMS ]] || \
    die "no SHA256SUMS in $name — it predates checksums, or was written with --no-verify"
  command -v sha256sum >/dev/null 2>&1 || die "sha256sum not found"

  local total
  total=$(grep -c . < "$snap/SHA256SUMS" || true)
  info "verifying $name ($total files)"

  local out rc=0
  out=$( cd "$snap" && sha256sum --quiet -c SHA256SUMS 2>&1 ) || rc=$?
  if (( rc == 0 )); then
    ok "$name verified — $total files match"
    return 0
  fi
  printf '%s\n' "$out" >&2
  die "$name FAILED verification (see above) — re-pull it, or take a fresh backup"
}

# ---------------------------------------------------------------------------
# Cleanup of *.pre-hop.* leftovers from past restores
# ---------------------------------------------------------------------------

# HOME-relative roots keepsake could have written a *.pre-hop.* backup
# under: every manifest path across all file groups, plus $DEV_ROOT.
clean_scan_roots() {
  local g rel
  for g in "${ALL_FILE_GROUPS[@]}"; do
    while IFS= read -r rel; do
      [[ -n $rel ]] && printf '%s\n' "$rel"
    done < <(parse_manifest "$g")
  done
  if [[ -n ${DEV_ROOT:-} && -d $DEV_ROOT ]]; then
    rel=${DEV_ROOT#"$HOME"/}
    [[ $rel != "$DEV_ROOT" ]] && printf '%s\n' "$rel"
  fi
}

cmd_clean() {
  ensure_manifest
  if [[ -n $OLDER_THAN ]]; then
    [[ $OLDER_THAN =~ ^[0-9]+$ ]] || die "--older-than must be a non-negative integer (days)"
  fi
  # find's -mtime +N matches "more than N days old", not ">= N days old" —
  # subtract 1 so --older-than N means "N days old or older". --older-than 0
  # (or no --older-than, for the preview) means "any age", so no filter.
  local -a mtime_args=()
  if [[ -n $OLDER_THAN && $OLDER_THAN -gt 0 ]]; then
    mtime_args=(-mtime "+$((OLDER_THAN - 1))")
  fi

  local -a found=()
  local rel root f
  while IFS= read -r rel; do
    if is_abs_path "$rel"; then
      root=$rel
    else
      root="$HOME/$rel"
    fi
    while IFS= read -r -d '' f; do
      found+=("$f")
    done < <(find "$(dirname "$root")" -maxdepth 1 -name "$(basename "$root").pre-hop.*" \
      "${mtime_args[@]}" -print0 2>/dev/null)
    if [[ -d $root ]]; then
      while IFS= read -r -d '' f; do
        found+=("$f")
      done < <(find "$root" -depth -name '*.pre-hop.*' \
        "${mtime_args[@]}" -print0 2>/dev/null)
    fi
  done < <(clean_scan_roots)

  # dedupe
  local -A seen=()
  local -a uniq=()
  for f in "${found[@]}"; do
    [[ -n ${seen[$f]:-} ]] && continue
    seen[$f]=1
    uniq+=("$f")
  done

  if ((${#uniq[@]} == 0)); then
    ok "no *.pre-hop.* leftovers found"
    return 0
  fi

  if [[ -z $OLDER_THAN ]]; then
    printf '%s%d *.pre-hop.* leftover(s)%s\n' "$C_BOLD" "${#uniq[@]}" "$C_RESET"
    for f in "${uniq[@]}"; do
      printf '  %-60s %s\n' "$f" "$(du -sh "$f" 2>/dev/null | cut -f1)"
    done
    printf '  %stotal: %s%s\n' "$C_DIM" "$(du -shc "${uniq[@]}" 2>/dev/null | tail -1 | cut -f1)" "$C_RESET"
    info "nothing deleted — re-run with --older-than N (or --older-than 0 to remove all of the above)"
    return 0
  fi

  local reclaimed
  reclaimed=$(du -shc "${uniq[@]}" 2>/dev/null | tail -1 | cut -f1)
  for f in "${uniq[@]}"; do
    if (( DRY_RUN )); then
      printf '  would delete %s\n' "$f"
    else
      rm -rf -- "$f"
    fi
  done
  if (( DRY_RUN )); then
    ok "dry-run finished (${#uniq[@]} would be deleted, ~$reclaimed)"
  else
    ok "deleted ${#uniq[@]} leftover(s), reclaimed ~$reclaimed"
  fi
}

# ---------------------------------------------------------------------------
# Resolve a snapshot argument to a directory
# ---------------------------------------------------------------------------

resolve_snapshot() {
  local arg=$1
  local cand
  if [[ -d $arg && ( -d $arg/files || -d $arg/dev ) ]]; then
    printf '%s\n' "$(cd "$arg" && pwd)"
    return
  fi
  if [[ -f $arg && $arg == *.tar.* ]]; then
    die "packed snapshots: extract first, e.g.  tar -C $(dirname "$arg") -xf $arg"
  fi
  for cand in "$arg" "$DATA_DIR/$arg" "$DATA_DIR/$arg"* "$SCRIPT_DIR/snapshots/$arg"; do
    if [[ -d $cand && -d $cand/files ]]; then
      printf '%s\n' "$(cd "$cand" && pwd)"
      return
    fi
  done
  die "snapshot not found: $arg  (try: keepsake list)"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# A pre-rename ~/.local/bin/distrohop symlinked straight at $SCRIPT_DIR/distrohop
# (the old script file). That path no longer exists after the rename, so the
# symlink went dangling and any distrohop-backup.timer still enabled from
# before started failing to even launch — silently, since nothing runs to
# report it. Swap the units for the current ones so `keepsake install`
# (already the documented upgrade step) finishes the migration in one go
# instead of leaving a separate manual systemd step to forget.
migrate_systemd_units() {
  local sd="$HOME/.config/systemd/user"
  [[ -d $sd ]] || return 0
  [[ -f $sd/distrohop-backup.timer || -f $sd/distrohop-backup.service ]] || return 0
  [[ -f $sd/keepsake-backup.timer ]] && return 0
  [[ -f $SCRIPT_DIR/systemd/keepsake-backup.timer && -f $SCRIPT_DIR/systemd/keepsake-backup.service ]] || return 0

  local was_enabled=0
  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user is-enabled distrohop-backup.timer >/dev/null 2>&1 && was_enabled=1
    systemctl --user disable --now distrohop-backup.timer >/dev/null 2>&1 || true
  fi
  rm -f "$sd/distrohop-backup.timer" "$sd/distrohop-backup.service"
  cp "$SCRIPT_DIR/systemd/keepsake-backup.timer" "$SCRIPT_DIR/systemd/keepsake-backup.service" "$sd/"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl --user daemon-reload 2>/dev/null || true
    if (( was_enabled )); then
      if systemctl --user enable --now keepsake-backup.timer 2>/dev/null; then
        info "migrated the systemd timer: distrohop-backup → keepsake-backup"
      else
        warn "moved systemd units to keepsake-backup, but couldn't enable the timer — run: systemctl --user enable --now keepsake-backup.timer"
      fi
      return 0
    fi
  fi
  info "moved systemd units: distrohop-backup → keepsake-backup (was not enabled — enable with: systemctl --user enable --now keepsake-backup.timer)"
}

cmd_install() {
  local dest="$HOME/.local/bin/keepsake"
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$SCRIPT_DIR/keepsake" "$dest"
  # Old command name kept as a symlink so existing timers and scripts keep working.
  ln -sfn "$dest" "$HOME/.local/bin/distrohop"
  ensure_manifest
  ok "linked $dest → $SCRIPT_DIR/keepsake"
  if [[ :$PATH: != *":$HOME/.local/bin:"* ]]; then
    warn "$HOME/.local/bin is not on PATH — add it, or open a new terminal"
  fi
  migrate_systemd_units
}

cmd_config() {
  local sub=${1:-} key=${2:-} val=${3:-}
  case $key in
    dev_root|'') ;;
    *) die "unknown setting: $key (known: dev_root)" ;;
  esac
  case $sub in
    get)
      [[ -n $key ]] || die "usage: keepsake config get KEY"
      local v=""
      conf_load_kv "$SETTINGS_CONF" "$key" 2>/dev/null || true
      v=${!key:-}
      printf '%s\n' "$v"
      ;;
    set)
      [[ -n $key ]] || die "usage: keepsake config set KEY VALUE"
      mkdir -p "$CONFIG_DIR"
      touch "$SETTINGS_CONF"
      local tmp="$SETTINGS_CONF.tmp"
      grep -vE "^${key}=" "$SETTINGS_CONF" > "$tmp" 2>/dev/null || : > "$tmp"
      printf '%s=%s\n' "$key" "$val" >> "$tmp"
      mv "$tmp" "$SETTINGS_CONF"
      ok "$key=$val → $SETTINGS_CONF"
      ;;
    *) die "usage: keepsake config get|set KEY [VALUE]" ;;
  esac
}

cmd_edit() {
  ensure_manifest
  local editor
  if command -v micro >/dev/null 2>&1; then
    editor=micro
  else
    editor=${EDITOR:-${VISUAL:-nano}}
  fi
  exec "$editor" "$MANIFEST"
}

# shellcheck disable=SC2088  # "~/..." here is display text, not a path
cmd_status() {
  ensure_manifest
  printf '%sWhat would be copied%s  groups: %s%s%s\n\n' \
    "$C_BOLD" "$C_RESET" "$C_CYN" "$(active_groups | tr '\n' ' ')" "$C_RESET"

  local g rel src count=0 missing=0
  for g in "${ALL_FILE_GROUPS[@]}"; do
    group_wanted "$g" || continue
    local shown=0
    while IFS= read -r rel; do
      [[ -z $rel ]] && continue
      local src label
      if is_abs_path "$rel"; then
        src=$rel
        label=$rel
      else
        src="$HOME/$rel"
        label="~/$rel"
      fi
      if item_exists "$src"; then
        ((shown)) || { printf '%s[%s]%s\n' "$C_BOLD" "$g" "$C_RESET"; shown=1; }
        local sz
        sz=$(du -sh "$src" 2>/dev/null | cut -f1)
        printf '  %-42s %s\n' "$label" "$sz"
        count=$((count + 1))
      else
        ((shown)) || { printf '%s[%s]%s\n' "$C_BOLD" "$g" "$C_RESET"; shown=1; }
        printf '  %s%-42s missing%s\n' "$C_DIM" "$label" "$C_RESET"
        missing=$((missing + 1))
      fi
    done < <(parse_manifest "$g")
    ((shown)) && printf '\n'
  done

  if group_wanted packages; then
    local pm; pm=$(pm_detect)
    printf '%s[packages]%s\n' "$C_BOLD" "$C_RESET"
    if [[ $pm != none ]]; then
      printf '  explicit  %s\n' "$(pm_explicit_packages "$pm" 2>/dev/null | wc -l)"
      [[ $pm == pacman ]] && printf '  aur       %s\n' "$(pacman -Qqm | wc -l)"
    else
      printf '  %s(no supported package manager found)%s\n' "$C_DIM" "$C_RESET"
    fi
    printf '  flatpak   %s\n' "$(flatpak list --app 2>/dev/null | wc -l)"
    printf '\n'
  fi

  if declare -F dev_status >/dev/null; then
    dev_status
  fi
  if declare -F devapps_status >/dev/null; then
    devapps_status
  fi

  info "$count present, $missing missing"
  info "destination: ${DEST_OVERRIDE:-$DATA_DIR}"
}

cmd_backup() {
  ensure_manifest

  local stamp host name dest
  stamp=$(date +%Y-%m-%d_%H%M%S)
  host=$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf '%s' "${HOSTNAME:-unknown}")
  name=${NAME_OVERRIDE:-${stamp}_${host}}
  dest="${DEST_OVERRIDE:-$DATA_DIR}/$name"

  if [[ -e $dest ]]; then
    die "already exists: $dest"
  fi

  info "snapshot → $dest"
  info "groups:   $(active_groups | tr '\n' ' ')"

  if (( DRY_RUN )); then
    cmd_status
    return 0
  fi

  mkdir -p "$dest/files"
  write_meta "$dest"
  dump_packages "$dest/packages"
  if declare -F devapps_backup >/dev/null; then
    devapps_backup "$dest" || warn "dev-apps inventory failed — the rest of the snapshot is still being written"
  fi
  write_notes "$dest"

  local g rel copied=0
  : > "$dest/MANIFEST.txt"
  for g in "${ALL_FILE_GROUPS[@]}"; do
    group_wanted "$g" || continue
    [[ $g == secrets ]] && continue
    while IFS= read -r rel; do
      [[ -z $rel ]] && continue
      if is_abs_path "$rel"; then
        if copy_system_item "$rel" "$dest"; then
          printf '%s\t%s\n' "$g" "$rel" >> "$dest/MANIFEST.txt"
          copied=$((copied + 1))
        fi
      elif copy_item "$rel" "$dest/files"; then
        printf '%s\t%s\n' "$g" "$rel" >> "$dest/MANIFEST.txt"
        copied=$((copied + 1))
      fi
    done < <(parse_manifest "$g")
  done

  if group_wanted secrets; then
    mkdir -p "$dest/secrets"
    while IFS= read -r rel; do
      [[ -z $rel ]] && continue
      if is_abs_path "$rel"; then
        if copy_system_item "$rel" "$dest"; then
          printf '%s\t%s\n' "secrets" "$rel" >> "$dest/MANIFEST.txt"
          copied=$((copied + 1))
        fi
      elif copy_item "$rel" "$dest/secrets"; then
        printf '%s\t%s\n' "secrets" "$rel" >> "$dest/MANIFEST.txt"
        copied=$((copied + 1))
      fi
    done < <(parse_manifest secrets)
    chmod -R go= "$dest/secrets" 2>/dev/null || true
    # the snapshot root too — secrets/ is only as private as its parent
    chmod go= "$dest" 2>/dev/null || true
  fi

  if group_wanted dev && declare -F dev_backup >/dev/null; then
    dev_backup "$dest" || warn "dev group backup had errors — the rest of the snapshot is intact"
  fi

  write_checksums "$dest"

  if (( WANT_ARCHIVE )); then
    local archive="${dest}.tar.zst"
    info "packing $archive"
    if command -v zstd >/dev/null 2>&1; then
      tar -C "$(dirname "$dest")" -I 'zstd -T0 -19' -cf "$archive" "$(basename "$dest")"
    else
      archive="${dest}.tar.xz"
      tar -C "$(dirname "$dest")" -cJf "$archive" "$(basename "$dest")"
    fi
    # tar honours umask, so an archive of a snapshot containing private keys
    # would otherwise land at 0644.
    if [[ -d $dest/secrets ]]; then
      chmod 600 "$archive" 2>/dev/null || true
    fi
    ok "archive $(du -sh "$archive" | cut -f1)  $archive"
  fi

  ok "copied $copied items  $(du -sh "$dest" | cut -f1)"

  if (( WANT_PUSH )); then
    declare -F s3_push_dir >/dev/null || die "s3 push unavailable (lib/s3.sh missing)"
    s3_push_dir "$dest"
  fi

  printf '\n%sNext%s\n' "$C_BOLD" "$C_RESET"
  printf '  restore:   keepsake restore %s\n' "$name"
  printf '  portable:  %s packages\n' "$(wc -l < "$dest/packages/portable.txt")"
  if [[ -s $dest/packages/kde-session.txt ]]; then
    printf '  desktop:   %s DE-session packages (packages/kde-session.txt)\n' "$(wc -l < "$dest/packages/kde-session.txt")"
  fi
  if ! group_wanted secrets; then
    warn "secrets not included — rerun with --secrets to keep ssh keys / rclone"
  fi
}

# Snapshot directories under $1 (default: active data dir), oldest-first.
# Prints: epoch<TAB>when<TAB>path
#
# Ordering comes from the recorded snapshot date (meta/date), falling back to
# the directory mtime. NEVER sort these by name: a custom --name (e.g.
# "workstation") is not time-sortable, and name order would make prune delete
# newer snapshots while keeping older ones.
list_snapshot_dirs() {
  local dir=${1:-${DEST_OVERRIDE:-$DATA_DIR}} d when epoch
  [[ -d $dir ]] || return 0
  shopt -s nullglob
  for d in "$dir"/*/; do
    d=${d%/}
    [[ -d $d/files || -d $d/meta ]] || continue
    when=$(cat "$d/meta/date" 2>/dev/null || true)
    epoch=""
    [[ -n $when ]] && epoch=$(date -d "$when" +%s 2>/dev/null || true)
    if [[ -z $epoch ]]; then
      epoch=$(stat -c %Y "$d" 2>/dev/null || echo 0)
      [[ -n $when ]] || when=$(date -Iseconds -d "@$epoch" 2>/dev/null || echo unknown)
    fi
    printf '%s\t%s\t%s\n' "$epoch" "$when" "$d"
  done | sort -t $'\t' -k1,1n -k3,3
  shopt -u nullglob
}

# Newest snapshot by recorded date (not by name). Empty if there is none.
latest_snapshot_dir() {
  list_snapshot_dirs | tail -n1 | cut -f3
}

cmd_list() {
  local dir=${DEST_OVERRIDE:-$DATA_DIR}
  if [[ ! -d $dir ]]; then
    warn "no snapshots yet in $dir"
    return 0
  fi

  local -a entries=()
  local epoch d when
  while IFS=$'\t' read -r epoch when d; do
    entries+=("$when"$'\t'"$d")
  done < <(list_snapshot_dirs "$dir")

  if (( ${#entries[@]} == 0 )); then
    warn "no snapshots yet in $dir"
    return 0
  fi

  # Cross-reference against S3/R2 (best-effort, single remote listing).
  # Skipped silently if s3 isn't configured, or times out if offline.
  local -a remote_names=()
  local check_remote=0
  if declare -F s3_load_conf >/dev/null && s3_load_conf 2>/dev/null; then
    check_remote=1
    local remote
    remote=$(s3_rclone_env 2>/dev/null && timeout 5 rclone lsf "r2:$(s3_remote_path '')" --dirs-only 2>/dev/null)
    while IFS= read -r n; do
      [[ -n $n ]] && remote_names+=("${n%/}")
    done <<< "$remote"
  fi

  local header_fmt='%s%-28s %8s  %-25s'
  (( check_remote )) && header_fmt+='  %s'
  header_fmt+='%s\n'
  if (( check_remote )); then
    printf "$header_fmt" "$C_DIM" "NAME" "SIZE" "WHEN" "S3" "$C_RESET"
  else
    printf "$header_fmt" "$C_DIM" "NAME" "SIZE" "WHEN" "$C_RESET"
  fi

  local line name size mark n found
  while IFS=$'\t' read -r when d; do
    name=$(basename "$d")
    size=$(du -sh "$d" | cut -f1)
    if (( check_remote )); then
      found=0
      for n in "${remote_names[@]}"; do
        [[ $n == "$name" ]] && { found=1; break; }
      done
      if (( found )); then
        mark="${C_GRN}✔ pushed${C_RESET}"
      else
        mark="${C_DIM}— local only${C_RESET}"
      fi
      printf '%-28s %8s  %-25s  %b\n' "$name" "$size" "$when" "$mark"
    else
      printf '%-28s %8s  %s\n' "$name" "$size" "$when"
    fi
  done < <(printf '%s\n' "${entries[@]}" | tac)
}

cmd_prune() {
  local dir=${DEST_OVERRIDE:-$DATA_DIR}
  local keep=${KEEP_N:-$PRUNE_DEFAULT_KEEP}
  [[ $keep =~ ^[0-9]+$ ]] || die "--keep must be a non-negative integer"
  if [[ ! -d $dir ]]; then
    warn "no snapshots yet in $dir"
    return 0
  fi

  local snaps=() epoch when d
  while IFS=$'\t' read -r epoch when d; do snaps+=("$d"); done < <(list_snapshot_dirs "$dir")
  local total=${#snaps[@]}
  if (( total <= keep )); then
    info "$total snapshot(s), keeping $keep — nothing to prune"
    return 0
  fi

  local drop=$(( total - keep )) i name archive
  info "$total snapshot(s), keeping $keep newest — pruning $drop"
  for (( i = 0; i < drop; i++ )); do
    name=$(basename "${snaps[i]}")
    if (( DRY_RUN )); then
      printf '  would delete %s\n' "$name"
      continue
    fi
    rm -rf -- "${snaps[i]}"
    for archive in "${snaps[i]}.tar.zst" "${snaps[i]}.tar.xz"; do
      [[ -e $archive ]] && rm -f -- "$archive"
    done
    ok "deleted $name"
  done
  (( DRY_RUN )) && ok "dry-run finished ($drop would be deleted)"
}

cmd_delete() {
  local name=${1:-}
  [[ -n $name ]] || die "usage: keepsake delete NAME [--local-only|--s3-only] [--dry-run]"
  (( WANT_LOCAL_ONLY && WANT_S3_ONLY )) && die "--local-only and --s3-only are mutually exclusive"

  local do_local=1 do_s3=1
  (( WANT_LOCAL_ONLY )) && do_s3=0
  (( WANT_S3_ONLY )) && do_local=0
  local found=0

  if (( do_local )); then
    local dir=${DEST_OVERRIDE:-$DATA_DIR} snap archive
    snap="$dir/$name"
    if [[ -d $snap ]]; then
      found=1
      if (( DRY_RUN )); then
        printf '  would delete local  %s\n' "$snap"
      else
        rm -rf -- "$snap"
        ok "deleted local $name"
      fi
      for archive in "$snap.tar.zst" "$snap.tar.xz"; do
        [[ -e $archive ]] || continue
        found=1
        if (( DRY_RUN )); then
          printf '  would delete local  %s\n' "$archive"
        else
          rm -f -- "$archive"
          ok "deleted local archive $(basename "$archive")"
        fi
      done
    elif (( do_s3 )); then
      warn "no local snapshot named $name"
    else
      die "no local snapshot named $name"
    fi
  fi

  if (( do_s3 )); then
    if declare -F s3_load_conf >/dev/null && s3_load_conf 2>/dev/null; then
      s3_rclone_env
      local remote
      remote="r2:$(s3_remote_path "$name")"
      if rclone lsf "$remote" --max-depth 1 2>/dev/null | grep -q .; then
        found=1
        if (( DRY_RUN )); then
          printf '  would delete remote %s\n' "$remote"
        else
          rclone purge "$remote" && ok "deleted remote $name" || die "failed to delete $remote"
        fi
      elif (( do_local )); then
        warn "no remote snapshot named $name"
      else
        die "no remote snapshot named $name"
      fi
    elif (( WANT_S3_ONLY )); then
      die "no s3 config — can't delete remote copy (keepsake s3 configure ENVFILE)"
    fi
  fi

  (( found )) || die "nothing found named $name (local or remote)"
  (( DRY_RUN )) && ok "dry-run finished"
}

cmd_show() {
  local snap
  snap=$(resolve_snapshot "${1:-}")
  printf '%s%s%s\n\n' "$C_BOLD" "$(basename "$snap")" "$C_RESET"
  if [[ -f $snap/NOTES.txt ]]; then
    cat "$snap/NOTES.txt"
    printf '\n'
  fi
  if [[ -f $snap/MANIFEST.txt ]]; then
    printf '%sContents%s\n' "$C_BOLD" "$C_RESET"
    if command -v column >/dev/null 2>&1; then
      column -t -s $'\t' "$snap/MANIFEST.txt"
    else
      cat "$snap/MANIFEST.txt"
    fi
  fi
}

cmd_restore() {
  local snap

  if (( WANT_PULL )); then
    [[ -n ${1:-} ]] || die "usage: keepsake restore NAME --pull"
    declare -F cmd_s3_pull >/dev/null || die "s3 pull unavailable (lib/s3.sh missing)"
    cmd_s3_pull "$1"
  fi

  snap=$(resolve_snapshot "${1:-}")
  ensure_manifest

  local orig_home
  orig_home=$(cat "$snap/meta/home" 2>/dev/null || echo "")
  if [[ -n $orig_home && $orig_home != "$HOME" ]]; then
    warn "snapshot was taken from $orig_home — restoring into $HOME"
  fi

  restore_pick_or_default "$snap"
  GROUPS_OVERRIDE=$PICKED

  info "restore ← $snap"
  info "selected: ${PICKED:-none}"
  (( DRY_RUN )) && warn "dry-run — nothing will be written"

  local g rel restored=0
  if restore_wanted files && [[ -d $snap/files ]]; then
    if (( DRY_RUN )); then
      rsync -a -n "$snap/files/" "$HOME/"
    else
      rsync -a --backup --suffix=".pre-hop.$(date +%Y%m%d%H%M%S)" "$snap/files/" "$HOME/"
    fi
    restored=1
  elif [[ -f $snap/MANIFEST.txt ]]; then
    while IFS=$'\t' read -r g rel; do
      [[ -z ${rel:-} ]] && continue
      [[ $g == secrets ]] && continue
      is_abs_path "$rel" && continue
      restore_wanted "$g" || continue
      if restore_item "$rel" "$snap/files"; then
        restored=$((restored + 1))
      fi
    done < "$snap/MANIFEST.txt"
  fi

  if [[ -f $snap/MANIFEST.txt ]]; then
    while IFS=$'\t' read -r g rel; do
      [[ -z ${rel:-} ]] && continue
      is_abs_path "$rel" || continue
      restore_wanted "$g" || continue
      if restore_system_item "$rel" "$snap"; then
        restored=$((restored + 1))
      fi
    done < "$snap/MANIFEST.txt"
    if (( ! DRY_RUN )); then
      apply_hwdb_if_needed "$snap"
    fi
  fi

  if restore_wanted secrets; then
    if [[ -d $snap/secrets ]]; then
      while IFS=$'\t' read -r g rel; do
        [[ $g == secrets ]] || continue
        is_abs_path "$rel" && continue
        restore_item "$rel" "$snap/secrets" && restored=$((restored + 1))
      done < "$snap/MANIFEST.txt"
    else
      warn "this snapshot has no secrets/ — it was created without --secrets"
    fi
  fi

  if declare -F dev_restore >/dev/null; then
    dev_restore "$snap" || warn "dev group restore had errors — continuing with the rest"
  fi

  if restore_wanted packages; then
    cmd_packages_apply 1 "$snap"
  fi

  if restore_wanted dev-apps && declare -F devapps_restore >/dev/null; then
    devapps_restore "$snap" || warn "dev-apps restore had errors — continuing with the rest"
  fi

  if (( ! DRY_RUN )); then
    if [[ -d $HOME/.config/systemd/user ]]; then
      systemctl --user daemon-reload 2>/dev/null || true
    fi
    ok "restored $restored items"
    info "existing files were saved as *.pre-hop.*"
    info "next: keepsake bootstrap   then   keepsake packages apply --portable"
  else
    ok "dry-run finished ($restored items would restore)"
  fi
}

cmd_clone() {
  local snap
  if [[ -n ${1:-} ]]; then
    snap=$(resolve_snapshot "$1")
  else
    snap=$(latest_snapshot_dir)
    [[ -n $snap ]] || die "no snapshot found — pass one: keepsake clone workstation"
  fi
  [[ -x $snap/dev/clone-dev.sh ]] || die "no clone map in $snap (backup with the dev group)"
  local args=()
  (( DRY_RUN )) && args+=(--dry-run)
  (( WANT_GH )) && args+=(--gh)
  info "rebuilding $DEV_ROOT from $(basename "$snap")$( (( WANT_GH )) && printf ' (gh repo clone)' )"
  "$snap/dev/clone-dev.sh" "${args[@]}"
}

cmd_packages_dump() {
  local out
  out="${DEST_OVERRIDE:-$DATA_DIR}/packages-$(date +%Y-%m-%d)"
  mkdir -p "$out"
  dump_packages "$out"
  ok "wrote package lists → $out"
  ls -1 "$out"
}

cmd_packages_apply() {
  local portable=${1:-0} pm
  pm=$(pm_detect)
  [[ $pm != none ]] || die "no supported package manager found (pacman/dnf/apt/zypper) — read packages/portable.txt and install by hand"

  local snap_dir="" list
  # Prefer the newest snapshot's lists
  if [[ -n ${2:-} ]]; then
    snap_dir=$(resolve_snapshot "$2")
  else
    snap_dir=$(latest_snapshot_dir)
  fi
  [[ -n $snap_dir && -d $snap_dir/packages ]] || die "no snapshot package lists found — run backup first"

  local snap_pm=""
  [[ -f $snap_dir/packages/pm.txt ]] && snap_pm=$(<"$snap_dir/packages/pm.txt")
  if [[ -n $snap_pm && $snap_pm != "$pm" ]]; then
    warn "snapshot captured on $snap_pm, applying on $pm — some names won't match; unresolved go to packages/unresolved.txt"
  fi

  if (( portable )); then
    list="$snap_dir/packages/portable.txt"
    info "installing portable packages (DE-session list skipped)"
  else
    list="$snap_dir/packages/explicit.txt"
    warn "installing the FULL explicit list, including DE-session packages"
  fi
  [[ -f $list ]] || die "missing $list"

  local pkgs=()
  mapfile -t pkgs < <(grep -vE '^\s*(#|$)' "$list")
  ((${#pkgs[@]})) || die "package list is empty"

  info "${#pkgs[@]} packages from $(basename "${snap_dir%/}")"
  if (( DRY_RUN )); then
    printf '%s\n' "${pkgs[@]}"
    return 0
  fi

  local resolved=() unresolved=() p
  for p in "${pkgs[@]}"; do
    pm_pkg_installed "$pm" "$p" && continue
    if pm_pkg_available "$pm" "$p"; then
      resolved+=("$p")
    else
      unresolved+=("$p")
    fi
  done
  if ((${#resolved[@]})); then
    pm_install_batch "$pm" "${resolved[@]}" || warn "some repo packages failed (normal if you changed distro flavour)"
  fi
  if ((${#unresolved[@]})); then
    printf '%s\n' "${unresolved[@]}" > "$snap_dir/packages/unresolved.txt"
    warn "${#unresolved[@]} packages had no match on $pm — see packages/unresolved.txt"
  fi

  if [[ $pm == pacman ]] && [[ -f $snap_dir/packages/aur.txt ]] && command -v paru >/dev/null 2>&1; then
    local aur=()
    if (( portable )); then
      if [[ -f $snap_dir/packages/kde-session.txt ]]; then
        mapfile -t aur < <(grep -vE '^\s*(#|$)' "$snap_dir/packages/aur.txt" | while read -r p; do
          is_kde_session "$p" && continue
          printf '%s\n' "$p"
        done)
      else
        warn "no DE-session split in this snapshot — --portable installs all AUR packages unfiltered"
        mapfile -t aur < <(grep -vE '^\s*(#|$)' "$snap_dir/packages/aur.txt")
      fi
    else
      mapfile -t aur < <(grep -vE '^\s*(#|$)' "$snap_dir/packages/aur.txt")
    fi
    if ((${#aur[@]})); then
      info "AUR via paru: ${aur[*]}"
      paru -S --needed -- "${aur[@]}" || warn "some AUR packages failed"
    fi
  fi

  if [[ -s $snap_dir/packages/flatpak.txt ]] && command -v flatpak >/dev/null 2>&1; then
    local app
    while IFS= read -r app; do
      [[ -z $app ]] && continue
      info "flatpak $app"
      flatpak install -y --noninteractive "$app" 2>/dev/null || warn "flatpak failed: $app"
    done < "$snap_dir/packages/flatpak.txt"
  fi

  ok "package apply finished"
}

cmd_bootstrap() {
  local pm; pm=$(pm_detect)
  [[ $pm != none ]] || die "bootstrap needs a supported package manager (pacman/dnf/apt/zypper) — install zsh + a prompt + plugins by hand."

  if [[ $pm == pacman ]]; then
    local repo=(
      zsh
      zsh-theme-powerlevel10k
      zsh-syntax-highlighting
      zsh-autosuggestions
      zsh-history-substring-search
      fzf
      bat
      trash-cli
      fastfetch
      alacritty
      pkgfile
      ttf-meslo-nerd
      ttf-jetbrains-mono-nerd
      git
      github-cli
    )
    local aur=(oh-my-zsh-git ttf-victor-mono)

    info "shell + prompt + fonts that your zshrc expects"
    if (( DRY_RUN )); then
      printf 'pacman: %s\n' "${repo[*]}"
      printf 'aur:    %s\n' "${aur[*]}"
      return 0
    fi

    sudo pacman -S --needed -- "${repo[@]}"
    if command -v paru >/dev/null 2>&1; then
      paru -S --needed -- "${aur[@]}"
    else
      warn "paru not found — install oh-my-zsh-git and ttf-victor-mono from the AUR yourself"
    fi
  else
    # No AUR-equivalent on dnf/apt/zypper: install what's packaged, git-clone
    # the rest (oh-my-zsh, p10k, plugins) instead of running oh-my-zsh's
    # interactive installer (it mutates .zshrc, which keepsake restores
    # separately as the user's own file).
    local repo_names=(zsh fzf bat trash-cli fastfetch alacritty git github-cli)
    info "shell + prompt + fonts that your zshrc expects ($pm)"

    local resolved=() unresolved=() name cand r
    for name in "${repo_names[@]}"; do
      r=""
      while IFS= read -r cand; do
        [[ -z $cand ]] && continue
        if pm_pkg_available "$pm" "$cand"; then r=$cand; break; fi
      done < <(pm_map_pkg "$pm" "$name")
      if [[ -n $r ]]; then resolved+=("$r"); else unresolved+=("$name"); fi
    done

    if (( DRY_RUN )); then
      printf '%s: %s\n' "$pm" "${resolved[*]}"
      ((${#unresolved[@]})) && printf 'no package found for: %s\n' "${unresolved[*]}"
      printf 'git-clone → ~/.local/share/keepsake/zsh-plugins: oh-my-zsh, powerlevel10k, zsh-autosuggestions, zsh-syntax-highlighting, zsh-history-substring-search\n'
      return 0
    fi

    ((${#resolved[@]})) && { pm_install_batch "$pm" "${resolved[@]}" || warn "some repo packages failed"; }
    ((${#unresolved[@]})) && warn "no $pm package for: ${unresolved[*]} — install by hand"

    local plugdir="$HOME/.local/share/keepsake/zsh-plugins"
    mkdir -p "$plugdir"
    local -A clones=(
      [oh-my-zsh]=https://github.com/ohmyzsh/ohmyzsh.git
      [powerlevel10k]=https://github.com/romkatv/powerlevel10k.git
      [zsh-autosuggestions]=https://github.com/zsh-users/zsh-autosuggestions.git
      [zsh-syntax-highlighting]=https://github.com/zsh-users/zsh-syntax-highlighting.git
      [zsh-history-substring-search]=https://github.com/zsh-users/zsh-history-substring-search.git
    )
    local plug
    for plug in "${!clones[@]}"; do
      if [[ -d $plugdir/$plug/.git ]]; then
        info "already cloned: $plug"
      else
        info "git clone $plug"
        git clone --depth 1 "${clones[$plug]}" "$plugdir/$plug" || warn "clone failed: $plug"
      fi
    done
    info "note: .zshrc may need to source these from $plugdir instead of the Arch /usr/share/... paths it expects"

    # Fonts: try a repo package first, else fall back to the upstream
    # nerd-fonts release zips (best-effort; version may need bumping later).
    local fonts_dir="$HOME/.local/share/fonts" have_font_pkg=0
    mkdir -p "$fonts_dir"
    for cand in jetbrains-mono-fonts jetbrains-mono-nerd-fonts nerd-fonts-jetbrains-mono; do
      if pm_pkg_available "$pm" "$cand"; then
        pm_install_batch "$pm" "$cand" && have_font_pkg=1
        break
      fi
    done
    if (( ! have_font_pkg )); then
      if command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
        info "downloading JetBrainsMono + Meslo + VictorMono Nerd Fonts"
        local nf_ver=3.3.0 fontname tmpzip
        for fontname in JetBrainsMono Meslo VictorMono; do
          tmpzip=$(mktemp)
          if curl -fsSL "https://github.com/ryanoasis/nerd-fonts/releases/download/v${nf_ver}/${fontname}.zip" -o "$tmpzip"; then
            unzip -o -q "$tmpzip" -d "$fonts_dir" '*.ttf' '*.otf' 2>/dev/null
            ok "installed $fontname Nerd Font"
          else
            warn "font download failed: $fontname — install manually from the nerd-fonts GitHub releases"
          fi
          rm -f "$tmpzip"
        done
        fc-cache -f "$fonts_dir" >/dev/null 2>&1 || true
      else
        warn "curl/unzip not found — install JetBrainsMono/Meslo/VictorMono Nerd Fonts by hand"
      fi
    fi
  fi

  if [[ ${SHELL:-} != *zsh ]]; then
    info "switching login shell to zsh"
    local zsh_bin; zsh_bin=$(command -v zsh || true)
    if [[ -n $zsh_bin ]]; then
      chsh -s "$zsh_bin" || warn "chsh failed — run: chsh -s $zsh_bin"
    else
      warn "zsh not found on PATH — install it first"
    fi
  fi
  ok "bootstrap done — open a new terminal"
}

cmd_dconf() {
  local sub=${1:-}
  local file=${2:-$CONFIG_DIR/dconf.ini}
  case $sub in
    export)
      command -v dconf >/dev/null 2>&1 || die "dconf not installed"
      mkdir -p "$(dirname "$file")"
      dconf dump / > "$file"
      ok "dumped dconf → $file"
      ;;
    import)
      command -v dconf >/dev/null 2>&1 || die "dconf not installed"
      [[ -f $file ]] || die "no dump at $file — run: keepsake dconf export"
      dconf load / < "$file"
      ok "loaded $file into dconf"
      ;;
    *)
      die "usage: keepsake dconf export|import [FILE]"
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Arg parse
# ---------------------------------------------------------------------------

PORTABLE=0
POSITIONAL=()

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    -V|--version) printf '%s\n' "$VERSION"; exit 0 ;;
    --dry-run) DRY_RUN=1; shift ;;
    --secrets) WANT_SECRETS=1; shift ;;
    --archive) WANT_ARCHIVE=1; shift ;;
    --up) WANT_UP=1; shift ;;
    --gh) WANT_GH=1; shift ;;
    --yes|-y) WANT_YES=1; shift ;;
    --portable) PORTABLE=1; shift ;;
    --no-verify) WANT_NO_VERIFY=1; shift ;;
    --push) WANT_PUSH=1; shift ;;
    --pull) WANT_PULL=1; shift ;;
    --local-only) WANT_LOCAL_ONLY=1; shift ;;
    --s3-only) WANT_S3_ONLY=1; shift ;;
    --name) NAME_OVERRIDE=${2:?}; shift 2 ;;
    --dest) DEST_OVERRIDE=${2:?}; shift 2 ;;
    --groups) GROUPS_OVERRIDE=${2:?}; shift 2 ;;
    --with) WITH_GROUPS=${2:?}; shift 2 ;;
    --keep) KEEP_N=${2:?}; shift 2 ;;
    --older-than) OLDER_THAN=${2:?}; shift 2 ;;
    --) shift; POSITIONAL+=("$@"); break ;;
    -*) die "unknown flag: $1" ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"
cmd=${1:-help}
shift || true

case $cmd in
  help) usage ;;
  install) cmd_install ;;
  edit) cmd_edit ;;
  status) cmd_status ;;
  backup) cmd_backup ;;
  list|ls) cmd_list ;;
  show)
    [[ $# -ge 1 ]] || die "usage: keepsake show SNAPSHOT"
    cmd_show "$1"
    ;;
  verify)
    [[ $# -ge 1 ]] || die "usage: keepsake verify SNAPSHOT"
    cmd_verify "$1"
    ;;
  restore)
    [[ $# -ge 1 ]] || die "usage: keepsake restore SNAPSHOT"
    cmd_restore "$1"
    ;;
  clone)
    cmd_clone "${1:-}"
    ;;
  prune) cmd_prune ;;
  delete|rm)
    [[ $# -ge 1 ]] || die "usage: keepsake delete NAME [--local-only|--s3-only]"
    cmd_delete "$1"
    ;;
  clean) cmd_clean ;;
  config) cmd_config "${1:-}" "${2:-}" "${3:-}" ;;
  packages)
    sub=${1:-}
    case $sub in
      dump) cmd_packages_dump ;;
      apply) cmd_packages_apply "$PORTABLE" "${2:-}" ;;
      *) die "usage: keepsake packages dump|apply [--portable]" ;;
    esac
    ;;
  bootstrap) cmd_bootstrap ;;
  dconf) cmd_dconf "${1:-}" "${2:-}" ;;
  s3) cmd_s3 "$@" ;;
  *) die "unknown command: $cmd  (try: keepsake help)" ;;
esac
